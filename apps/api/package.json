{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "build": "tsc",
    "prestart": "node dist/db/migrate.js latest",
    "start": "node dist/server.js",
    "worker:prod": "node dist/workers/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "db:migrate": "ts-node-dev --transpile-only --exit-child src/db/migrate.ts latest",
    "db:migrate:prod": "node dist/db/migrate.js latest",
    "db:rollback": "ts-node-dev --transpile-only --exit-child src/db/migrate.ts rollback",
    "db:seed": "ts-node-dev --transpile-only --exit-child src/db/seed.ts",
    "db:reset": "ts-node-dev --transpile-only --exit-child src/db/migrate.ts rollback-all && ts-node-dev --transpile-only --exit-child src/db/migrate.ts latest && ts-node-dev --transpile-only --exit-child src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@google/generative-ai": "^0.24.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@uniconnect/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "mammoth": "^1.12.3",
    "morgan": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "resend": "^6.9.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
