# Environment
NODE_ENV=development

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
WEB_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres@localhost:5432/uniconnect_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=UniConnecT <noreply@uniconnectt.me>
EMAIL_FROM=UniConnecT <noreply@uniconnectt.me>

# AWS / S3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=uniconnect-local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_PUBLIC_URL=

# OTP
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Dev Seeds
DEV_INVITE_TOKEN=dev-invite
DEV_INVITE_EMAIL=student@uiu.ac.bd
DEV_INVITE_ROLE=student

# Skyvern
SKYVERN_API_KEY=
SKYVERN_BASE_URL=https://api.skyvern.com
SKYVERN_CONTENT_WORKFLOW_ID=
SKYVERN_RUN_TIMEOUT_MS=600000

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@uniconnectt.me

# KLIPY
KLIPY_API_KEY=
KLIPY_CONTENT_FILTER=high

# AI / Academic LMS
GEMINI_API_KEY=
AI_CONTENT_ENABLED=true
AI_QUIZ_GEN_HOUR=1
# Deprecated / unused: the AI group-posting cron now runs hourly and each academic group
# is scheduled from its own ai_settings.run_hour. Retained for backward compatibility only.
AI_GROUP_POST_HOUR=8
