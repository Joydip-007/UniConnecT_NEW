{
  "mcpServers": {
    "Azure MCP Server": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "shadcn": {
      "command": "./apps/web/node_modules/.bin/shadcn",
      "args": [
        "mcp"
      ]
    }
  }
}
