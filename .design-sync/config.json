  "readmeHeader": ".design-sync/conventions.md",
  "libOverrides": {
    "bundle.mjs": "tsconfigPathsPlugin extension probe checked bare directory match before /index.ts; existsSync() is true for dirs too, so @/-alias directory imports resolved to the directory instead of its index file",
    "source-kit.mjs": "cfg.srcInclude allowlist so broadened srcDir='src' (needed to reach features/*/components) doesn't sweep main.tsx/pages/hooks/stores into the synth-entry export * bundle; also adds default-export re-export codegen and srcExclude/srcExcludeExports collision handling for same-named components across feature dirs",
    "common.mjs": "adds srcInclude/srcExclude/srcExcludeExports to CONFIG_KEYS, paired with the source-kit.mjs fork"
  }
